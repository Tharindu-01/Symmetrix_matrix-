
public class SymmetricMatrix {

    static class ColumnVector {
        int[] data;

        ColumnVector(int[] data) {
            this.data = data;
        }

        int get(int index) {
            return data[index];
        }

        void display() {
            for (int i = 0; i < data.length; i++) {
                System.out.print(data[i] + " ");
            }
            System.out.println();
        }
    }

    static class Matrix {
        int size;
        ColumnVector[] columns;

        Matrix(int size) {
            this.size = size;
            columns = new ColumnVector[size];

            for (int i = 0; i < size; i++) {
                columns[i] = new ColumnVector(new int[size]);
            }
        }

        void set(int row, int col, int value) {
            columns[col].data[row] = value;
            columns[row].data[col] = value;
        }

        int get(int row, int col) {
            return columns[col].get(row);
        }

        void display() {
            for (int i = 0; i < size; i++) {
                for (int j = 0; j < size; j++) {
                    System.out.print(get(i, j) + " ");
                }
                System.out.println();
            }
        }
    }

    public static void main(String[] args) {

        Matrix matrix = new Matrix(3);

        matrix.set(0, 0, 1);
        matrix.set(0, 1, 2);
        matrix.set(0, 2, 3);
        matrix.set(1, 1, 4);
        matrix.set(1, 2, 5);
        matrix.set(2, 2, 6);

        System.out.println("Symmetric Matrix:");

        matrix.display();
    }
}
